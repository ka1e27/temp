{
  "name": "hex-dominion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A minimalist idle conquest game. Zero dependencies, no build step.",
  "scripts": {
    "start": "node tools/serve.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "watch": "node --test --watch \"tests/**/*.test.js\"",
    "check": "node tools/checksize.js && node tools/checkpure.js",
    "verify": "npm run check && npm test",
    "sim": "node tools/simrunner.js",
    "mobile": "node tools/mobile.mjs"
  }
}
